{
  "name": "shiyin-ncm",
  "version": "1.1.0",
  "description": "拾音 NCM：离线 NCM 转 MP3 工具",
  "author": "mochenHG",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/engine.test.js",
    "test:ui": "node tests/ui.cjs",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.58.0",
    "sharp": "^0.34.0"
  },
  "build": {
    "appId": "cn.mochen.shiyin.ncm",
    "productName": "拾音 NCM",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg-LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg-README.txt"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Shiyin-NCM-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mochenHG/shiyin-ncm.git"
  },
  "homepage": "https://github.com/mochenHG/shiyin-ncm"
}
